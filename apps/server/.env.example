PORT=3000
DASH_API_BASE_URL=https://api.goswift.ly
DASH_API_AGENCY=alexandria-dash
DASH_API_KEY=your_api_key_here
DASH_API_TIMEOUT_MS=10000
# Trusted reverse proxies (load balancer, PaaS router) in front of the server. 0 ignores X-Forwarded-For; set it only to the number of proxies you control, or clients can forge the IP the rate limit keys on.
TRUST_PROXY_HOPS=0
